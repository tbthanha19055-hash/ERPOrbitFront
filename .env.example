# URL Express backend của bạn
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Firebase Admin / Firestore — không thêm NEXT_PUBLIC_ vào các biến này
# Có thể dùng một trong hai cách bên dưới.

# Cách 1: dán toàn bộ service account JSON trên một dòng
FIREBASE_SERVICE_ACCOUNT_JSON=

# Cách 2: lấy từ Firebase Console > Project settings > Service accounts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""
